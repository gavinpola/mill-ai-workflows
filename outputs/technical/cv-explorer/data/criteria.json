{
  "criteria": [
    {
      "id": "accuracy",
      "label": "Classification accuracy",
      "shortLabel": "Accuracy",
      "description": "Food identification precision measured by mAP@50",
      "defaultWeight": 0.25,
      "scoringGuide": {
        "5": "95%+ mAP, multi-class segmentation, handles mixed items",
        "4": "85-94% mAP, reliable classification for most food types",
        "3": "75-84% mAP, acceptable accuracy, some challenging items",
        "2": "60-74% mAP, limited accuracy, requires fusion",
        "1": "<60% mAP, unreliable standalone"
      },
      "impact": "Higher weight favors premium cameras, multi-angle systems, and mechanical separation"
    },
    {
      "id": "friction",
      "label": "User friction",
      "shortLabel": "Friction",
      "description": "How much does it slow or complicate the disposal process",
      "defaultWeight": 0.25,
      "scoringGuide": {
        "5": "Zero behavioral change, identical to current bin (10/10)",
        "4": "Minimal change, slight feel difference (8-9/10)",
        "3": "Noticeable change, brief delay acceptable (7/10)",
        "2": "Significant change, may impact adoption (5-6/10)",
        "1": "Major workflow change, likely resistance (<5/10)"
      },
      "impact": "Higher weight favors passive sensing, no mechanical components"
    },
    {
      "id": "feasibility",
      "label": "Technical feasibility",
      "shortLabel": "Feasibility",
      "description": "Development complexity and time-to-market risk",
      "defaultWeight": 0.20,
      "scoringGuide": {
        "5": "Off-the-shelf components, proven integration",
        "4": "Minor R&D needed, 2-3 month integration",
        "3": "Moderate R&D, 4-6 month development",
        "2": "Significant R&D, 6-12 month timeline",
        "1": "Research stage, 12+ months, high uncertainty"
      },
      "impact": "Higher weight favors proven technologies and existing components"
    },
    {
      "id": "cost",
      "label": "Hardware cost",
      "shortLabel": "Cost",
      "description": "Per-unit hardware expense relative to $3K baseline",
      "defaultWeight": 0.15,
      "scoringGuide": {
        "5": "<$2,500 (-15% or more vs baseline)",
        "4": "$2,500-3,500 (baseline range)",
        "3": "$3,500-4,500 (+15-50% vs baseline)",
        "2": "$4,500-6,000 (+50-100% vs baseline)",
        "1": ">$6,000 (100%+ premium)"
      },
      "impact": "Higher weight favors simpler sensor configurations"
    },
    {
      "id": "maintenance",
      "label": "Maintenance burden",
      "shortLabel": "Maintenance",
      "description": "Ongoing operational cost, cleaning, and reliability",
      "defaultWeight": 0.10,
      "scoringGuide": {
        "5": "<30 min/month, passive sensors, self-calibrating",
        "4": "30-60 min/month, occasional cleaning",
        "3": "1-2 hours/month, regular cleaning required",
        "2": "2-4 hours/month, moving parts, frequent attention",
        "1": ">4 hours/month, complex maintenance"
      },
      "impact": "Higher weight favors solid-state sensors over mechanical systems"
    },
    {
      "id": "differentiation",
      "label": "Competitive differentiation",
      "shortLabel": "Differentiation",
      "description": "Uniqueness vs competitors, patent potential, moat value",
      "defaultWeight": 0.05,
      "scoringGuide": {
        "5": "Patentable innovation, unique in market",
        "4": "Novel application, not seen in food waste",
        "3": "Incremental improvement over competitors",
        "2": "Comparable to existing solutions",
        "1": "Commodity approach, no differentiation"
      },
      "impact": "Higher weight favors novel approaches over proven-but-common"
    }
  ],
  "presets": [
    {
      "id": "accuracy-first",
      "name": "Accuracy-first",
      "description": "Prioritize data quality over cost",
      "weights": {
